{
 "title": "AnalystOS",
 "uid": "analystos",
 "schemaVersion": 39,
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "refresh": "30s",
 "panels": [
  {
   "type": "stat",
   "title": "Analyses (1h)",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum(increase(analystos_analysis_seconds_count[1h]))",
     "refId": "A"
    }
   ]
  },
  {
   "type": "stat",
   "title": "Analysis p95 (1h)",
   "gridPos": {
    "x": 6,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.95, sum(rate(analystos_analysis_seconds_bucket[1h])) by (le))",
     "refId": "A"
    }
   ]
  },
  {
   "type": "stat",
   "title": "Tool success rate (1h)",
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum(increase(analystos_tool_calls_total{status=\"success\"}[1h])) / sum(increase(analystos_tool_calls_total[1h]))",
     "refId": "A"
    }
   ]
  },
  {
   "type": "stat",
   "title": "Unsafe SQL blocked (24h)",
   "gridPos": {
    "x": 18,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum(increase(analystos_sql_blocked_total[24h]))",
     "refId": "A"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Analysis latency",
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.5, sum(rate(analystos_analysis_seconds_bucket[5m])) by (le))",
     "legendFormat": "p50",
     "refId": "A"
    },
    {
     "expr": "histogram_quantile(0.95, sum(rate(analystos_analysis_seconds_bucket[5m])) by (le))",
     "legendFormat": "p95",
     "refId": "B"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Tool calls by outcome",
   "gridPos": {
    "x": 12,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ops"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum(rate(analystos_tool_calls_total[5m])) by (tool, status)",
     "legendFormat": "{{tool}} {{status}}",
     "refId": "A"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "LLM tokens",
   "gridPos": {
    "x": 0,
    "y": 12,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum(rate(analystos_llm_tokens_total[5m])) by (direction)",
     "legendFormat": "{{direction}}",
     "refId": "A"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "LLM latency p95 by purpose",
   "gridPos": {
    "x": 12,
    "y": 12,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.95, sum(rate(analystos_llm_seconds_bucket[5m])) by (le, purpose))",
     "legendFormat": "{{purpose}}",
     "refId": "A"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Retries",
   "gridPos": {
    "x": 0,
    "y": 20,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ops"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum(rate(analystos_tool_retries_total[5m])) by (tool)",
     "legendFormat": "{{tool}}",
     "refId": "A"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "SQL duration p95 by dialect",
   "gridPos": {
    "x": 12,
    "y": 20,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.95, sum(rate(analystos_query_seconds_bucket[5m])) by (le, dialect))",
     "legendFormat": "{{dialect}}",
     "refId": "A"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Sandbox runs",
   "gridPos": {
    "x": 0,
    "y": 28,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ops"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum(rate(analystos_sandbox_runs_total[5m])) by (status)",
     "legendFormat": "{{status}}",
     "refId": "A"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Claims by verification outcome",
   "gridPos": {
    "x": 12,
    "y": 28,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ops"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum(rate(analystos_claims_total[5m])) by (status)",
     "legendFormat": "{{status}}",
     "refId": "A"
    }
   ]
  }
 ]
}
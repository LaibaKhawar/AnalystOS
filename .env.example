# Copy to .env (docker compose reads it) and fill in the secrets.
# Generate secrets with:
#   SECRET_KEY:      python -c "import secrets; print(secrets.token_hex(32))"
#   ENCRYPTION_KEY:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

ENVIRONMENT=development
SECRET_KEY=
ENCRYPTION_KEY=

# Application database (PostgreSQL + pgvector) and Redis
POSTGRES_USER=analystos
POSTGRES_PASSWORD=analystos
POSTGRES_DB=analystos
DATABASE_URL=postgresql+psycopg://analystos:analystos@postgres:5432/analystos
REDIS_URL=redis://redis:6379/0

# LLM provider: any OpenAI-compatible endpoint.
#   Ollama on the host:   LLM_BASE_URL=http://host.docker.internal:11434/v1  LLM_MODEL=qwen3:14b  LLM_API_KEY=ollama
#   OpenAI:               LLM_BASE_URL=https://api.openai.com/v1           LLM_MODEL=gpt-4o-mini LLM_API_KEY=sk-...
#   Azure OpenAI:         LLM_PROVIDER=azure_openai LLM_BASE_URL=https://<resource>.openai.azure.com LLM_MODEL=<deployment>
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=analystos-qwen3-8b
LLM_TEMPERATURE=0.1

# Embeddings for retrieve_previous_analysis (optional; leave empty to use keyword search)
EMBEDDING_BASE_URL=http://host.docker.internal:11434/v1
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768

# Optional per-model price overrides (YAML: model: {input: usd_per_1M, output: usd_per_1M})
PRICING_FILE=

# Python sandbox (Docker). The worker needs access to the Docker daemon to start sandbox containers.
SANDBOX_ENABLED=true
SANDBOX_IMAGE=analystos-sandbox:latest
SANDBOX_CPUS=1.0
SANDBOX_MEMORY_MB=512
SANDBOX_TIMEOUT_SECONDS=30

# Limits
MAX_UPLOAD_MB=200
SQL_MAX_ROWS=5000
SQL_TIMEOUT_SECONDS=20
AGENT_MAX_STEPS=12
AGENT_MAX_RETRIES_PER_STEP=3

CORS_ORIGINS=http://localhost:5173,http://localhost:3000
LOG_LEVEL=INFO
LOG_JSON=true
